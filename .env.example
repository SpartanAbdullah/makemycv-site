NEXT_PUBLIC_KOFI_USERNAME=makemycv_ae
NEXT_PUBLIC_PAYPAL_ME_HANDLE=Abdullah2431

# Sentry error tracking — https://abdullah-bsw.sentry.io/ project "makemycv-site".
# Org is on Sentry's EU region (note the .de. in the ingest host). The marketing
# site ships no CSP, so no header change is needed here.
#
# The DSN is public by design — it ships in the client bundle, hence the
# NEXT_PUBLIC_ prefix. It is not a secret; it only allows sending events INTO
# this project. SENTRY_ORG/PROJECT are build-time only, used by withSentryConfig
# for source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=abdullah-bsw
SENTRY_PROJECT=makemycv-site

# Sentry source-map upload token. Build-time only, NEVER exposed to the client.
# Create at: Settings > Developer Settings > Auth Tokens (scope: project:releases)
SENTRY_AUTH_TOKEN=

# Google Tag Manager container. This is the GTM CONTAINER id (GTM-…), NOT the GA4
# measurement id — GA4 (G-8MWPD87FJH) is configured inside the container, never in
# this codebase. Putting a G- id here requests a container that does not exist and
# silently kills all analytics.
#
# LEAVE THIS EMPTY, HERE AND IN .env.local. It is set ONLY in Vercel → Settings →
# Environment Variables, scoped to the Production environment (Preview and
# Development unchecked). That is the whole point: localhost and preview
# deployments then load no Google tag and cannot pollute the production GA4
# property. Filling it in locally re-creates the exact problem this fixes.
#
# Production value: GTM-5H2LMVJT
NEXT_PUBLIC_GTM_ID=
